\b Reverse a String (using StringBuilder class)\par
\par
\b0 public class Strings \{\par
   public static void main(String args[]) \{\par
     StringBuilder sb = new StringBuilder("HelloWorld");\par
    \par
     for(int i=0; i<sb.length()/2; i++) \{\par
       int front = i;\par
       int back = sb.length() - i - 1;\par
\par
\par
       char frontChar = sb.charAt(front);\par
       char backChar = sb.charAt(back);\par
\par
\par
       sb.setCharAt(front, backChar);\par
