\b Sudoku Solver (Backtracking 2) -----> Java\par
\b0\par
Write a program to solve a Sudoku puzzle by filling the empty cells.\par
A sudoku solution must satisfy all of the following rules:\par
Each of the digits 1-9 must occur exactly once in each row.\par
Each of the digits 1-9 must occur exactly once in each column.\par
Each of the digits 1-9 must occur exactly once in each of the 9 3x3 sub-boxes of the grid.\par
The '.' character indicates empty cells.\par
\par
Sample Input\par
\par
\par
\par
board = [["5","3",".",".","7",".",".",".","."],["6",".",".","1","9","5",".",".","."],[".","9","8",".",".",".",".","6","."],["8",".",".",".","6",".",".",".","3"],["4",".",".","8",".","3",".",".","1"],["7",".",".",".","2",".",".",".","6"],[".","6",".",".",".",".","2","8","."],[".",".",".","4","1","9",".",".","5"],[".",".",".",".","8",".",".","7","9"]]\par
\par
\par
\par
\par
Sample Output\par
\par
\par
[["5","3","4","6","7","8","9","1","2"],["6","7","2","1","9","5","3","4","8"],["1","9","8","3","4","2","5","6","7"],["8","5","9","7","6","1","4","2","3"],["4","2","6","8","5","3","7","9","1"],["7","1","3","9","2","4","8","5","6"],["9","6","1","5","3","7","2","8","4"],["2","8","7","4","1","9","6","3","5"],["3","4","5","2","8","6","1","7","9"]]\par
Code\par
StartingRow = 3*(row/3) & StartingCol = 3*(col/3)\par
StartingRow = row - row%3 & StartingCol = col - col%3\par
Code\par
\par
class Solution \{\par
   public boolean isSafe(char[][] board, int row, int col, int number) \{\par
       //column\par
       for(int i=0; i<board.length; i++) \{\par
           if(board[i][col] == (char)(number+'0')) \{\par
               return false;\par
           \}\par
       \}\par
      \par
       //row\par
       for(int j=0; j<board.length; j++) \{\par
           if(board[row][j] == (char)(number+'0')) \{\par
               return false;\par
           \}\par
       \}\par
      \par
       //grid\par
       int sr = 3 * (row/3);\par
       int sc = 3 * (col/3);\par
      \par
       for(int i=sr; i<sr+3; i++) \{\par
           for(int j=sc; j<sc+3; j++) \{\par
               if(board[i][j] == (char)(number+'0')) \{\par
                   return false;\par
               \}\par
           \}\par
       \}\par
      \par
       return true;\par
   \}\par
  \par
   public boolean helper(char[][] board, int row, int col) \{\par
       if(row == board.length) \{\par
           return true;\par
       \}\par
      \par
       int nrow = 0;\par
       int ncol = 0;\par
      \par
       if(col == board.length-1) \{\par
           nrow = row + 1;\par
           ncol = 0;\par
       \} else \{\par
           nrow = row;\par
           ncol = col + 1;\par
       \}\par
      \par
       if(board[row][col] != '.') \{\par
           if(helper(board, nrow, ncol)) \{\par
               return true;\par
           \}\par
       \} else \{\par
          \par
           //fill the place\par
           for(int i=1; i<=9; i++) \{\par
               if(isSafe(board, row, col, i)) \{\par
                   board[row][col] = (char)(i+'0');\par
                   if(helper(board, nrow, ncol))\par
                       return true;\par
                   else\par
                        board[row][col] = '.';\par
               \}\par
           \}\par
       \}\par
                     \par
       return false;\par
   \}\par
  \par
   public void solveSudoku(char[][] board) \{\par
       helper(board, 0, 0);\par
   \}\par
\}\par
