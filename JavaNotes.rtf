\b Take an array of numbers as input and check if it is an array sorted in ascending order.\par
\b0 Eg : \{ 1, 2, 4, 7 \} is sorted in ascending order.\par
       \{3, 4, 6, 2\} is not sorted in ascending order.\par
import java.util.*;\par
public class Arrays \{\par
   public static void main(String args[]) \{\par
      Scanner sc = new Scanner(System.in);\par
      int size = sc.nextInt();\par
      int numbers[] = new int[size];\par
      //input\par
      for(int i=0; i<size; i++) \{\par
          numbers[i] = sc.nextInt();\par
      \}\par
      boolean isAscending = true;\par
       for(int i=0; i<numbers.length-1; i++) \{ // NOTICE numbers.length - 1 as termination condition\par
           if(numbers[i] > numbers[i+1]) \{ // This is the condition for descending order\par
               isAscending = false;\par
           \}\par
       \}\par
       if(isAscending) \{\par
           System.out.println("The array is sorted in ascending order");\par
       \} else \{\par
           System.out.println("The array is not sorted in ascending order");\par
       \}\par
      \par
   \}\par
\}\par
